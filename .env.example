# FlagHunter configuration. Copy to .env and fill in your own values.
# .env is git-ignored; never commit real keys.

# Gemini is OPTIONAL and only reviews ambiguous findings after local detectors.
# Leave GEMINI_API_KEY empty to run fully offline (rule-based only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
